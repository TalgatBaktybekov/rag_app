# Environment variables for RAG Application

# Database Configuration
POSTGRES_USER=myuser
POSTGRES_PASSWORD=password
POSTGRES_DB=rag_app
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Security
SECRET_KEY=your-super-secret-jwt-key-here-change-in-production-minimum-32-chars
ENVIRONMENT=development

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Application Settings
HOST=0.0.0.0
PORT=8000

# LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# File Upload Settings
MAX_FILE_SIZE=52428800  # 50MB in bytes
UPLOAD_DIRECTORY=data
CHROMA_PERSIST_DIRECTORY=embeddings/chroma_db

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
